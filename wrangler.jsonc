/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hevy-mcp-server",
	"account_id": "7bcf0e448e8a8a8b1af2e610332ce6d3",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Each stateless MCP request builds a fresh McpServer (17 tool schemas),
	 * so give it headroom; the old 50 ms ceiling was sized for the DO design.
	 */
	"limits": {
		"cpu_ms": 1000
	},
	/**
	 * Durable Object history. v1 created the MyMCP session class used by the
	 * deprecated McpAgent transport; v2 (4.0.0) deletes it now that the MCP
	 * endpoint is stateless. Keep both entries: Wrangler replays migrations.
	 */
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyMCP"
			],
			"tag": "v1"
		},
		{
			"deleted_classes": [
				"MyMCP"
			],
			"tag": "v2"
		}
	],
	"observability": {
		"enabled": true
	},
	/**
	 * KV Namespaces - Production
	 * Sessions, OAuth clients/codes/tokens and encrypted per-user Hevy API keys
	 */
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "c449b150e27b4ed6a7f958e81495da16"
		}
	],
	/**
	 * Production Routes
	 * Custom domain configuration for production deployment
	 */
	"routes": [
		{
			"pattern": "hevy.tomt.it",
			"custom_domain": true
		}
	],
	/**
	 * Development Environment
	 * Separate KV namespace, no custom route (avoids Host header issues locally)
	 */
	"env": {
		"dev": {
			"name": "hevy-mcp-server-dev",
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "b58f63e9889b4f87b6ad153501e1e165"
				}
			]
		}
	}
	/**
	 * Secrets (set with `wrangler secret put`): GITHUB_CLIENT_ID,
	 * GITHUB_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY. Locally they live in .dev.vars.
	 */
}
